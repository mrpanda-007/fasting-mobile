<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/fasting_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/fasting_widget_background"
  android:orientation="vertical"
  android:padding="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/fasting_widget_protocol" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="#6B665E" android:textSize="13sp" />
    <TextView android:id="@+id/fasting_widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxWidth="150dp" android:singleLine="true" android:textColor="#C67139" android:textSize="10sp" android:textStyle="bold" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="18dp" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
      <Chronometer android:id="@+id/fasting_widget_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#1A1A1A" android:textSize="52sp" />
      <TextView android:text="ELAPSED TODAY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6B665E" android:textSize="10sp" />
      <ProgressBar android:id="@+id/fasting_widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="13dp" android:progressDrawable="@drawable/fasting_widget_progress" />
      <TextView android:id="@+id/fasting_widget_supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:maxLines="2" android:textColor="#6B665E" android:textSize="12sp" />
      <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="24dp" android:background="#CFC9BF" />
      <TextView android:id="@+id/fasting_widget_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#6B665E" android:textSize="18sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="88dp" android:layout_height="match_parent" android:layout_marginStart="16dp" android:orientation="vertical">
      <TextView android:id="@+id/fasting_widget_metric_one_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8A847A" android:textSize="9sp" />
      <TextView android:id="@+id/fasting_widget_metric_one_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1A1A1A" android:textSize="17sp" android:textStyle="bold" />
      <TextView android:id="@+id/fasting_widget_metric_two_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="#8A847A" android:textSize="9sp" />
      <TextView android:id="@+id/fasting_widget_metric_two_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1A1A1A" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
