<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/fasting_widget_background"
  android:padding="17dp">
  <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/fasting_ring_preview" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="FASTING" android:textColor="#C67139" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="13:42" android:textColor="#1A1A1A" android:textSize="20sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="elapsed" android:textColor="#6B665E" android:textSize="10sp" />
  </LinearLayout>
</FrameLayout>
